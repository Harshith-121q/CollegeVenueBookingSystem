# Database Configuration (REQUIRED for production)
# For local development: mongodb://localhost:27017/collegeVenue
# For production: Get your MongoDB Atlas connection string at https://www.mongodb.com/cloud/atlas
DB_URL=mongodb+srv://username:password@cluster.mongodb.net/collegeVenue

# Server Configuration  how to get my mono
PORT=5000
NODE_ENV=production

# JWT Secret (REQUIRED - use a strong random string)
SECRET_KEY=your-super-secret-jwt-key-here-change-this



